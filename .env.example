# Copier ce fichier en `.env` (gitignored) et renseigner de vraies valeurs
# avant de lancer `docker compose -f docker-compose.fusion.yml up`. Les mots
# de passe n'ont AUCUNE valeur par défaut dans docker-compose.fusion.yml :
# sans .env correctement rempli, le démarrage échoue explicitement plutôt que
# de tourner avec un secret vide.
#
# N'affecte PAS docker-compose.yml (stack BOS Light seule), qui garde ses
# valeurs par défaut en dur — ce fichier ne sert qu'à la stack fusionnée.

# Nom de projet Compose : fixe le préfixe des volumes/réseaux Docker créés
# (<projet>_<nom>). Garder la même valeur entre deux `docker compose up` est
# indispensable pour retomber sur les mêmes volumes Postgres/Keycloak (donc
# les mêmes données) d'une fois sur l'autre. "bos-light-mvp" est désormais le
# dépôt unique -- BOS Configurateur (frontend/) et BOS Exécution
# (frontend-client/) tournent ensemble ici, partageant le même backend
# (Keycloak, Postgres, API Gateway, ArcadeDB, NATS, SeaweedFS). Seule
# "userapp" (pas encore démarrée) tournera sous son propre nom de projet.
COMPOSE_PROJECT_NAME=bos-light-mvp

# --- BOS Light : BDD Identity (Keycloak) ---
POSTGRES_DB=bos_db
POSTGRES_USER=bos_user
POSTGRES_PASSWORD=changeme

# --- BOS Light : BDD métier applicative ---
POSTGRES_APP_DB=bos_app_db
POSTGRES_APP_USER=bos_app_user
POSTGRES_APP_PASSWORD=changeme

# --- BOS Light : console d'administration Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# --- MVP BIM : ArcadeDB ---
ARCADEDB_PASSWORD=changeme

# --- MVP BIM : NATS JetStream ---
NATS_USER=bos_admin
NATS_PASSWORD=changeme

# --- Tag de version des images maison (frontend, api-gateway, bim_api, ---
# --- timeseries_api, bim_validator). Laisser vide pour l'usage local     ---
# --- courant : retombe alors sur "dev" (docker-compose.fusion.yml),     ---
# --- rien ne change. Ne positionner (ex: sur un hash de commit court)   ---
# --- que pour construire/publier une version identifiable et rollback-  ---
# --- able -- voir ROLLBACK.md.
APP_VERSION=

# --- MVP BIM : ArcadeDB, utilisateur dédié Grafana (lecture seule sur "bim") ---
ARCADEDB_GRAFANA_PASSWORD=changeme

# --- MVP BIM : Grafana (cockpits time-series embarqués) ---
GRAFANA_ADMIN_PASSWORD=changeme

# --- Observabilité distribuée : OpenTelemetry -> Jaeger ---
# Interface Jaeger : http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_ENVIRONMENT=development
